{
  "name": "react-boilerplate-component",
  "version": "1.0.0",
  "homepage": "./",
  "private": true,
  "dependencies": {
    "@tailwindcss/forms": "^0.5.9",
    "@vitejs/plugin-react": "^4.3.3",
    "lodash": "^4.17.21",
    "pandasuite-bridge": "^4.6.0",
    "pandasuite-bridge-react": "^2.7.1",
    "prop-types": "^15.7.2",
    "react": "^18.3.1",
    "react-app-polyfill": "^3.0.0",
    "react-dom": "^18.3.1",
    "react-intl": "^6.8.1",
    "vite": "^5.4.10"
  },
  "scripts": {
    "start": "vite",
    "build": "vite build && rm -f ./pandasuite-component.zip && cd dist && zip -r -X '../pandasuite-component.zip' *",
    "preview": "vite preview",
    "release": "yarn build && release-it --no-npm.publish"
  },
  "eslintConfig": {
    "extends": [
      "react-app",
      "plugin:react/recommended",
      "prettier"
    ],
    "plugins": [
      "react-hooks"
    ],
    "rules": {
      "prettier/prettier": "error"
    }
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all",
      "IE >= 9",
      "Android > 0",
      "iOS > 0"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "devDependencies": {
    "autoprefixer": "^10.4.20",
    "eslint": "^9.13.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-import": "^2.31.0",
    "eslint-plugin-jsx-a11y": "^6.10.1",
    "eslint-plugin-react": "^7.37.2",
    "eslint-plugin-react-hooks": "^5.0.0",
    "postcss": "^8.4.47",
    "prettier": "^3.0.0",
    "release-it": "^17.10.0",
    "tailwindcss": "^3.4.14"
  },
  "release-it": {
    "github": {
      "release": true,
      "assets": [
        "pandasuite-component.zip"
      ]
    }
  }
}
